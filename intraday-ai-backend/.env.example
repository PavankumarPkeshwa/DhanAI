# Kotak Neo API Configuration
# Get your credentials from: https://kotakneostocks.kotaksecurities.com/

# Your Kotak Neo API Consumer Key
KOTAK_NEO_CONSUMER_KEY=your_consumer_key_here

# Your Kotak Neo API Consumer Secret
KOTAK_NEO_CONSUMER_SECRET=your_consumer_secret_here

# Your Kotak Neo API Access Token
KOTAK_NEO_ACCESS_TOKEN=your_access_token_here

# Server Port (optional, defaults to 5000)
PORT=5000
